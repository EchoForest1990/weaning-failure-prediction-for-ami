    print(f"  Best CV AUC: {random_search.best_score_:.4f}")

# Train final models with best hyperparameters
print("\nTraining final models...")
final_models = {}
os.makedirs('models', exist_ok=True)
for model_name, best_estimator in best_pipelines.items():
    final_clf = clone(base_models[model_name])
    best_params = best_estimator.named_steps['classifier'].get_params()
    final_clf.set_params(**best_params)
    if model_name in ["XGBoost", "LightGBM"]:
        final_clf.set_params(scale_pos_weight=scale_pos_weight)
    final_pipeline = Pipeline([('classifier', final_clf)])
    final_pipeline.fit(X_train_sel, y_train)
    final_models[model_name] = final_pipeline
    model_path = os.path.join('models', f'{fill_method}_{model_name}_final.pkl')
    joblib.dump(final_pipeline, model_path)
    print(f"  Saved {model_name} model to {model_path}")

# -------------------- Find optimal thresholds for original models --------------------
print("\nComputing optimal classification thresholds for each original model...")
optimal_thresholds_orig = {}
for model_name, pipeline in final_models.items():
    best_th, best_f1 = find_optimal_threshold(pipeline, X_train_sel, y_train, cv=5)
    optimal_thresholds_orig[model_name] = best_th
    print(f"  {model_name} optimal threshold = {best_th:.3f} (CV F1 = {best_f1:.3f})")

# -------------------- Evaluate original models on train and test sets --------------------
all_results = []
os.makedirs('plots_train', exist_ok=True)
os.makedirs('plots_test', exist_ok=True)
os.makedirs('test_predictions', exist_ok=True)

train_probas_orig = {}
test_probas_orig = {}

print("\nEvaluating original models with optimal thresholds...")
for model_name, pipeline in final_models.items():
    th = optimal_thresholds_orig[model_name]
    print(f"\n--- Original {model_name} (threshold = {th:.3f}) ---")

    # Train set
    result_train, y_proba_train, _ = evaluate_model_on_dataset(
        pipeline, X_train_sel, y_train, 'train', fill_method, model_name,
        threshold=th
    )
    all_results.append(result_train)
    train_probas_orig[model_name] = y_proba_train
    print(f"  Train: Recall = {result_train['Recall']:.3f}, Precision = {result_train['Precision']:.3f}, F1 = {result_train['F1']:.3f}")

    # Test set
    result_test, y_proba_test, y_pred_test = evaluate_model_on_dataset(
        pipeline, X_test_sel, y_test, 'test', fill_method, model_name,
        threshold=th
    )
    all_results.append(result_test)
    test_probas_orig[model_name] = y_proba_test
    print(f"  Test : Recall = {result_test['Recall']:.3f}, Precision = {result_test['Precision']:.3f}, F1 = {result_test['F1']:.3f}")

    # Save test predictions
    pred_df = pd.DataFrame({'True_Label': y_test, 'Pred_Prob': y_proba_test, 'Pred_Label': y_pred_test})
    pred_df.index.name = 'PatientID'
    pred_df.to_csv(os.path.join('test_predictions', f'{fill_method}_{model_name}_predictions.csv'))

# -------------------- Plotting --------------------
model_data_train = [{'name': name, 'y_proba': train_probas_orig[name]} for name in final_models.keys()]
plot_combined_curves(y_train, model_data_train, fill_method, 'plots_train', suffix='_original')
plot_dca(y_train, train_probas_orig, list(final_models.keys()), os.path.join('plots_train', 'dca_original.png'))

model_data_test = [{'name': name, 'y_proba': test_probas_orig[name]} for name in final_models.keys()]
plot_combined_curves(y_test, model_data_test, fill_method, 'plots_test', suffix='_original')
plot_dca(y_test, test_probas_orig, list(final_models.keys()), os.path.join('plots_test', 'dca_original.png'))

# -------------------- Save results --------------------
df_results = pd.DataFrame(all_results)
df_results.to_csv('all_results.csv', index=False)
print("\nAll results saved to all_results.csv")

