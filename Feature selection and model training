def compute_auc_ci(y_true, y_score, n_bootstrap=1000, random_state=42):
    np.random.seed(random_state)
    n = len(y_true)
    boot_scores = []
    for _ in range(n_bootstrap):
        idx = np.random.choice(n, n, replace=True)
        if np.sum(y_true[idx] == 1) == 0 or np.sum(y_true[idx] == 0) == 0:
            continue
        boot_scores.append(roc_auc_score(y_true[idx], y_score[idx]))
    lower = np.percentile(boot_scores, 2.5)
    upper = np.percentile(boot_scores, 97.5)
    return lower, upper

def hosmer_lemeshow(y_true, y_prob, groups=5):
    y_true = np.asarray(y_true)
    y_prob = np.asarray(y_prob)
    order = np.argsort(y_prob)
    y_true_sorted = y_true[order]
    y_prob_sorted = y_prob[order]
    n = len(y_true)
    if n < groups:
        return np.nan, np.nan
    group_size = n // groups
    observed = []
    expected = []
    for i in range(groups):
        start = i * group_size
        end = (i+1) * group_size if i < groups-1 else n
        obs = np.sum(y_true_sorted[start:end])
        exp = np.sum(y_prob_sorted[start:end])
        observed.append(obs)
        expected.append(exp)
    observed = np.array(observed)
    expected = np.array(expected)
    group_sizes = np.full(groups, group_size)
    group_sizes[-1] = n - (groups-1) * group_size
    denominator = expected * (1 - expected / group_sizes)
    if np.any(denominator <= 0):
        return np.nan, np.nan
    chi2_stat = np.sum((observed - expected)**2 / denominator)
    try:
        from scipy.stats import chi2
        p_value = 1 - chi2.cdf(chi2_stat, groups-2)
    except:
        p_value = np.nan
    return chi2_stat, p_value

def evaluate_model_on_dataset(model, X, y, dataset_name, fill_method, model_name, threshold=0.5):
    """
    Evaluate a model on a given dataset and return performance metrics.
    """
    y_proba = model.predict_proba(X)[:, 1]
    y_pred = (y_proba >= threshold).astype(int)
    tn, fp, fn, tp = confusion_matrix(y, y_pred).ravel()
    specificity = tn / (tn + fp) if (tn + fp) > 0 else 0
    ppv = tp / (tp + fp) if (tp + fp) > 0 else 0
    npv = tn / (tn + fn) if (tn + fn) > 0 else 0
    auc_val = roc_auc_score(y, y_proba)
    auc_lower, auc_upper = compute_auc_ci(y, y_proba)
    acc = accuracy_score(y, y_pred)
    recall = recall_score(y, y_pred)
    precision = precision_score(y, y_pred)
    f1 = f1_score(y, y_pred)
    brier = brier_score_loss(y, y_proba)
    logloss = log_loss(y, y_proba)
    hl_stat, hl_p = hosmer_lemeshow(y, y_proba)
    result = {
        'dataset': dataset_name, 'fill_method': fill_method, 'model': model_name,
        'AUC': auc_val, 'AUC_lower': auc_lower, 'AUC_upper': auc_upper,
        'Accuracy': acc, 'Recall': recall, 'Precision': precision,
        'Specificity': specificity, 'PPV': ppv, 'NPV': npv,
        'F1': f1, 'Brier': brier, 'LogLoss': logloss,
        'HL_pvalue': hl_p, 'Threshold_used': threshold
    }
    return result, y_proba, y_pred

def find_optimal_threshold(estimator, X, y, cv=5, threshold_range=101):
    """
    Find the threshold that maximizes F1 score using cross-validated probabilities.
    """
    print("   Computing cross-validated probabilities for threshold selection...")
    try:
        y_proba_cv = cross_val_predict(estimator, X, y, cv=cv, method='predict_proba', n_jobs=-1)[:, 1]
    except Exception as e:
        print(f"   Cross-validation failed ({e}), using training set predictions instead.")
        y_proba_cv = estimator.predict_proba(X)[:, 1]
    thresholds = np.linspace(0, 1, threshold_range)
    f1_scores = []
    for th in thresholds:
        y_pred_temp = (y_proba_cv >= th).astype(int)
        if np.sum(y_pred_temp) == 0 or np.sum(y_pred_temp) == len(y_pred_temp):
            f1_scores.append(0.0)
        else:
            f1_scores.append(f1_score(y, y_pred_temp))
    best_idx = np.argmax(f1_scores)
    best_threshold = thresholds[best_idx]
    best_f1 = f1_scores[best_idx]
    return best_threshold, best_f1

def plot_combined_curves(y_true, model_data, fill_method, save_dir, suffix=''):
    """
    Plot ROC, calibration, and clinical impact curves for multiple models.
    """
    fig, axes = plt.subplots(1, 3, figsize=(20, 6))
    for i, data in enumerate(model_data):
        color = COLOR_CYCLE[i % len(COLOR_CYCLE)]
        fpr, tpr, _ = roc_curve(y_true, data['y_proba'])
        roc_auc = auc(fpr, tpr)
        axes[0].plot(fpr, tpr, color=color, lw=2,
                     label=f"{data['name']} (AUC={roc_auc:.3f})")
        fraction_pos, mean_pred = calibration_curve(y_true, data['y_proba'], n_bins=7, strategy='uniform')
        axes[1].plot(mean_pred, fraction_pos, marker='o', color=color,
                     label=data['name'], markersize=3, linewidth=1)
        thresholds = np.linspace(0, 1, 101)
        high_risk_counts = [np.sum(data['y_proba'] >= thresh) for thresh in thresholds]
        event_counts = [np.sum((data['y_proba'] >= thresh) & (y_true == 1)) for thresh in thresholds]
        axes[2].plot(thresholds, high_risk_counts, color=color, linestyle='-',
                     label=f"{data['name']} (high risk)")
        axes[2].plot(thresholds, event_counts, color=color, linestyle='--',
                     label=f"{data['name']} (events)")
    axes[0].plot([0, 1], [0, 1], 'k--', lw=1, label='Chance')
    axes[0].set_xlim([0.0, 1.0]); axes[0].set_ylim([0.0, 1.05])
    axes[0].set_xlabel('False Positive Rate'); axes[0].set_ylabel('True Positive Rate')
    axes[0].set_title(f'ROC Curves - {fill_method}'); axes[0].legend(loc='lower right', fontsize=8)
    axes[0].grid(alpha=0.15, linestyle='--')
    axes[1].plot([0, 1], [0, 1], 'k--', label='Perfectly calibrated')
    axes[1].set_xlabel('Mean predicted probability'); axes[1].set_ylabel('Fraction of positives')
    axes[1].set_title(f'Calibration Curves - {fill_method}'); axes[1].legend(loc='lower right', fontsize=8)
    axes[1].grid(alpha=0.15, linestyle='--')
    axes[2].set_xlabel('Threshold probability'); axes[2].set_ylabel('Number of patients')
    axes[2].set_title(f'Clinical Impact Curves - {fill_method}'); axes[2].legend(loc='upper right', fontsize=8, ncol=2)
    axes[2].grid(alpha=0.15, linestyle='--')
    plt.suptitle(f'Model Performance - {fill_method}{suffix}', fontsize=16)
    plt.tight_layout(rect=[0, 0.03, 1, 0.95])
    plot_path = os.path.join(save_dir, f'combined_curves{suffix}.png')
    plt.savefig(plot_path, dpi=600, bbox_inches='tight')
    plt.close()
    print(f"Combined curves saved to {plot_path}")

def plot_dca(y_true, y_probas_dict, model_names, save_path):
    """
    Decision curve analysis for multiple models.
    """
    thresholds = np.linspace(0, 1, 101)
    plt.figure(figsize=(8, 6))
    n = len(y_true)
    for idx, name in enumerate(model_names):
        y_prob = y_probas_dict[name]
        color = COLOR_CYCLE[idx % len(COLOR_CYCLE)]
        net_benefit = []
        for thresh in thresholds:
            tp = np.sum((y_true == 1) & (y_prob >= thresh))
            fp = np.sum((y_true == 0) & (y_prob >= thresh))
            nb = (tp / n) - (fp / n) * (thresh / (1 - thresh))
            net_benefit.append(nb)
        plt.plot(thresholds, net_benefit, label=name, linewidth=2, color=color)
    all_tp = np.sum(y_true == 1)
    all_nb_curve = [(all_tp / n) - ((n - all_tp) / n) * (th / (1 - th)) for th in thresholds]
    plt.plot(thresholds, all_nb_curve, 'k--', label='Treat All')
    plt.plot(thresholds, [0]*len(thresholds), 'k-', label='Treat None')
    plt.xlim(0, 1.1)
    plt.ylim(-0.1, 0.4)
    plt.xlabel('Threshold Probability')
    plt.ylabel('Net Benefit')
    plt.title('Decision Curve Analysis')
    plt.legend(loc='best')
    plt.grid(alpha=0.15, linestyle='--')
    plt.savefig(save_path, dpi=600, bbox_inches='tight')
    plt.close()

def plot_sensitivity_analysis(data, dataset_name, fill_order):
    """
    Bar plots of performance metrics across models for a given imputation method.
    """
    subset = data.drop_duplicates(subset=['fill_method', 'model'])
    metrics_to_plot = ['AUC', 'Accuracy', 'Recall', 'Specificity', 'Precision', 'F1', 'Brier']
    fig, axes = plt.subplots(2, 4, figsize=(24, 12))
    axes = axes.flatten()
    for idx, metric in enumerate(metrics_to_plot):
        ax = axes[idx]
        pivot = subset.pivot(index='fill_method', columns='model', values=metric)
        pivot = pivot.reindex(fill_order)
        x = np.arange(len(pivot.index))
        width = 0.8 / len(pivot.columns)
        for j, model in enumerate(pivot.columns):
            color = COLOR_CYCLE[j % len(COLOR_CYCLE)]
            ax.bar(x + (j - len(pivot.columns)/2 + 0.5) * width, pivot[model], width,
                   label=model if idx == 0 else "", color=color, edgecolor='black')
        ax.set_title(metric, fontsize=14)
        ax.set_xticks(x)
        ax.set_xticklabels(pivot.index, rotation=45, ha='right')
        ax.set_ylim(0, 1.05)
        ax.grid(axis='y', linestyle='--', alpha=0.15)
    for idx in range(len(metrics_to_plot), len(axes)):
        axes[idx].set_visible(False)
    handles, labels = axes[0].get_legend_handles_labels()
    fig.legend(handles, labels, loc='upper center', bbox_to_anchor=(0.5, 0.02),
               ncol=len(pivot.columns), fontsize=10)
    plt.suptitle(f'Sensitivity Analysis - {dataset_name} Set (Original Models)', fontsize=16)
    plt.tight_layout(rect=[0, 0.05, 1, 0.95])
    save_path = f'sensitivity_analysis_{dataset_name}_original.png'
    plt.savefig(save_path, dpi=600, bbox_inches='tight')
    plt.close()
    print(f"Sensitivity analysis saved to {save_path}")

